# ZENO Backend Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# AI Model Configuration (Optional - falls back to built-in intelligent engine)
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_TEMPERATURE=0.7

# Hardware / ESP32 Configuration
ESP32_HEARTBEAT_TIMEOUT_MS=15000
DEVICE_NAME=ZENO

# Logging & Storage
LOG_LEVEL=info
DATA_DIR=./data
